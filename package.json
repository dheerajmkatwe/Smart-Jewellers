{
  "name": "smart-jewellers-saas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev": "wrangler pages dev -- npm run dev:ui",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:backup:create": "wrangler d1 backup create smart-jewellers-db",
    "db:backup:list": "wrangler d1 backup list smart-jewellers-db",
    "db:backup:restore": "wrangler d1 backup restore smart-jewellers-db"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.48.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.131.2"
  }
}
